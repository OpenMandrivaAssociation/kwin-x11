+namespace
+{
+// First positive ScreenScaleFactors entry, else ScaleFactor, else 1.
+qreal x11GlobalScale()
+{
+    KConfig globals(QStringLiteral("kdeglobals"));
+    const KConfigGroup kscreen = globals.group(QStringLiteral("KScreen"));
+    const QString factors = kscreen.readEntry(QStringLiteral("ScreenScaleFactors"), QString());
+    const auto parts = factors.split(QLatin1Char(';'), Qt::SkipEmptyParts);
+    for (const QString &part : parts) {
+        const int eq = part.indexOf(QLatin1Char('='));
+        if (eq < 0) {
+            continue;
+        }
+        bool ok = false;
+        const qreal value = QLocale::c().toDouble(part.mid(eq + 1), &ok);
+        if (ok && value > 0.0) {
+            return value;
+        }
+    }
+    if (kscreen.hasKey(QStringLiteral("ScaleFactor"))) {
+        const qreal scale = kscreen.readEntry(QStringLiteral("ScaleFactor"), 1.0);
+        if (scale > 0.0) {
+            return scale;
+        }
+    }
+    return 1.0;
+}
+
+// Breeze sizes buttons from the title font, not from output scale. X11 leaves
+// that scale at 1 and turns Qt screen scaling off. Multiply only the part of
+// the global factor that logical DPI has not already applied.
+qreal x11DecorationExtraScale()
+{
+    auto *app = qobject_cast<QGuiApplication *>(QCoreApplication::instance());
+    if (!app || app->platformName() != QLatin1String("xcb")) {
+        return 1.0;
+    }
+    const qreal globalScale = x11GlobalScale();
+    const QScreen *screen = app->primaryScreen();
+    const qreal logicalDpi = screen ? screen->logicalDotsPerInchY() : 96.0;
+    if (logicalDpi <= 1.0) {
+        return globalScale;
+    }
+    return globalScale / (logicalDpi / 96.0);
+}
+}
 
